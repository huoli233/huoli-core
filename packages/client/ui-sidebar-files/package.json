{
  "name": "@huoli/huoli-client-ui-sidebar-files",
  "description": "The workspace files page and one workspace directory tree per pane beside docked and floating file previews, listed lazily over the workspaceFiles Remote namespace",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-sidebar-files"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "huoli": {
    "client": {
      "inject": [
        "@huoli/huoli-api-workspace-files",
        "@huoli/huoli-client-ui-sidebar-right",
        "@huoli/huoli-client-ui-session",
        "@huoli/huoli-api-remotes",
        "@huoli/huoli-client-shortcuts",
        "@huoli/huoli-client-ui-context-menu"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@huoli/cordis": "workspace:~"
  },
  "devDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-api-remotes": "workspace:*",
    "@huoli/huoli-api-workspace-files": "workspace:*",
    "@huoli/huoli-client-locale": "workspace:*",
    "@huoli/huoli-client-store": "workspace:*",
    "@huoli/huoli-client-test-runtime": "workspace:*",
    "@huoli/huoli-client-ui-dockkit": "workspace:*",
    "@huoli/huoli-client-ui-primitives": "workspace:*",
    "@huoli/huoli-client-ui-renderer": "workspace:*",
    "@huoli/huoli-client-ui-session": "workspace:*",
    "@huoli/huoli-client-ui-sidebar-right": "workspace:*",
    "@huoli/huoli-client-ui-slots": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-typert-protocol": "workspace:*",
    "@huoli/huoli-util-workspace-path": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "clsx": "^2.0.0",
    "react-dom": "^18.2.0",
    "@huoli/huoli-client-shortcuts": "workspace:*",
    "@huoli/huoli-client-ui-context-menu": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
