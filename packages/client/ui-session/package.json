{
  "name": "@huoli/huoli-client-ui-session",
  "description": "Session Controller adapter for React and session-scoped slots",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huoli233/huoli-core.git",
    "directory": "packages/client/ui-session"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "huoli": {
    "client": {
      "inject": [
        "@huoli/huoli-api-remote-access",
        "@huoli/huoli-api-remotes",
        "@huoli/huoli-api-session-controller",
        "@huoli/huoli-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@huoli/cordis": "workspace:~"
  },
  "devDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-api-remote-access": "workspace:*",
    "@huoli/huoli-api-remotes": "workspace:*",
    "@huoli/huoli-api-session-controller": "workspace:*",
    "@huoli/huoli-client-store": "workspace:*",
    "@huoli/huoli-client-test-runtime": "workspace:*",
    "@huoli/huoli-client-ui-renderer": "workspace:*",
    "@huoli/huoli-client-ui-slots": "workspace:*",
    "@huoli/huoli-remote-mock": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-util-values": "workspace:*",
    "react": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
