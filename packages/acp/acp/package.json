{
  "name": "@huoli/huoli-acp",
  "description": "Automation-only Agent Client Protocol server for driving Huoli Core agents over JSON-RPC stdio",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huoli233/huoli-core.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@huoli/huoli-brand": "workspace:*",
    "@huoli/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-attachment": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-mcp-client": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-session-persistence": "workspace:*",
    "@huoli/huoli-token-meter": "workspace:*",
    "@huoli/huoli-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@huoli/huoli-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-agent-loop": "workspace:*",
    "@huoli/huoli-agent-loop-testkit": "workspace:*",
    "@huoli/huoli-attachment": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-mcp-client": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-session-persistence": "workspace:*",
    "@huoli/huoli-session-persistence-jsonl": "workspace:*",
    "@huoli/huoli-session-projection": "workspace:*",
    "@huoli/huoli-subagent": "workspace:*",
    "@huoli/huoli-token-meter": "workspace:*",
    "@huoli/huoli-tool-testkit": "workspace:*",
    "@huoli/huoli-tools": "workspace:*",
    "@huoli/huoli-user-approval": "workspace:*"
  }
}
