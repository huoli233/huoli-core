{
  "name": "@huoli/huoli-tool-bash",
  "description": "Model-facing bash tool with optional generic background-job and sandbox-escalation support",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huoli233/huoli-core.git",
    "directory": "packages/shell/tool-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-shell": "workspace:*",
    "@huoli/huoli-shell-env": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-sandbox": "workspace:*",
    "@huoli/huoli-sandbox-policy": "workspace:*",
    "@huoli/huoli-system-prompt": "workspace:*",
    "@huoli/huoli-jobs": "workspace:*",
    "@huoli/huoli-tools": "workspace:*",
    "@huoli/huoli-user-approval": "workspace:*",
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-working-directory": "workspace:*"
  },
  "dependencies": {
    "@huoli/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@huoli/huoli-ptc-runtime": "workspace:*",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-agent-loop": "workspace:*",
    "@huoli/huoli-agent-loop-testkit": "workspace:*",
    "@huoli/huoli-shell": "workspace:*",
    "@huoli/huoli-shell-env": "workspace:*",
    "@huoli/huoli-bash-local": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-subprocess-local": "workspace:*",
    "@huoli/huoli-sandbox": "workspace:*",
    "@huoli/huoli-sandbox-policy": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-session-persistence-jsonl": "workspace:*",
    "@huoli/huoli-system-prompt": "workspace:*",
    "@huoli/huoli-jobs": "workspace:*",
    "@huoli/huoli-jobs-local": "workspace:*",
    "@huoli/huoli-tool-executor-native": "workspace:*",
    "@huoli/huoli-tool-executor-ptc": "workspace:*",
    "@huoli/huoli-tool-jobs": "workspace:*",
    "@huoli/huoli-tool-testkit": "workspace:*",
    "@huoli/huoli-tools": "workspace:*",
    "@huoli/huoli-user-approval": "workspace:*",
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-session-projection": "workspace:*",
    "@huoli/huoli-working-directory": "workspace:*"
  }
}
