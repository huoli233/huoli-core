{
  "name": "@huoli/huoli-bash-sandbox",
  "description": "Sandbox-consuming implementation of the Huoli Core bash executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huoli233/huoli-core.git",
    "directory": "packages/shell/bash-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@huoli/huoli-shell": "workspace:*",
    "@huoli/huoli-bash-local": "workspace:*",
    "@huoli/huoli-sandbox": "workspace:*",
    "@huoli/huoli-sandbox-policy": "workspace:*",
    "@huoli/cordis": "workspace:~"
  },
  "devDependencies": {
    "@huoli/huoli-shell": "workspace:*",
    "@huoli/huoli-bash-local": "workspace:*",
    "@huoli/huoli-subprocess-local": "workspace:*",
    "@huoli/huoli-sandbox": "workspace:*",
    "@huoli/huoli-sandbox-local": "workspace:*",
    "@huoli/huoli-sandbox-policy": "workspace:*",
    "@huoli/cordis": "workspace:~",
    "@huoli/node-addon-system": "workspace:~",
    "@huoli/huoli-session-projection": "workspace:*"
  }
}
