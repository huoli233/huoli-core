{
  "name": "@huoli/huoli-llm-retry",
  "description": "Provider-routed LLM request retry policy for the Huoli Core",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huoli233/huoli-core.git",
    "directory": "packages/llm/llm-retry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@huoli/huoli-brand": "workspace:*",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-timeout": "workspace:*",
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-session-projection": "workspace:*"
  },
  "dependencies": {
    "@huoli/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@huoli/huoli-brand": "workspace:*",
    "@huoli/cordis-plugin-include": "workspace:~",
    "@huoli/cordis-plugin-loader": "workspace:~",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-agent-loop": "workspace:*",
    "@huoli/huoli-agent-loop-testkit": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-llm-deepseek": "workspace:*",
    "@huoli/huoli-llm-deepseek-api-key": "workspace:*",
    "@huoli/huoli-llm-mock-server": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-session-projection": "workspace:*",
    "@huoli/huoli-session-persistence-jsonl": "workspace:*",
    "@huoli/huoli-system-prompt": "workspace:*",
    "@huoli/huoli-timeout": "workspace:*",
    "@huoli/huoli-tool-executor-native": "workspace:*",
    "@huoli/huoli-tool-testkit": "workspace:*",
    "@huoli/huoli-tools": "workspace:*",
    "@huoli/cordis": "workspace:~"
  }
}
