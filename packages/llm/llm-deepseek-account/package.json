{
  "name": "@huoli/huoli-llm-deepseek-account",
  "description": "DeepSeek account provider authentication and discovery",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm-deepseek-account"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@huoli/cosmokit": "workspace:~",
    "@huoli/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-llm-deepseek": "workspace:*",
    "@huoli/huoli-launch-environment": "workspace:*",
    "@huoli/huoli-deepseek-account": "workspace:*",
    "@huoli/cordis-plugin-loader": "workspace:~"
  },
  "devDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-llm-deepseek": "workspace:*",
    "@huoli/huoli-launch-environment": "workspace:*",
    "@huoli/huoli-deepseek-account": "workspace:*",
    "@huoli/cordis-plugin-loader": "workspace:~",
    "@huoli/huoli-llm-deepseek-api-key": "workspace:*",
    "@huoli/huoli-timeout": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@huoli/huoli-deepseek-account": {
      "optional": true
    },
    "@huoli/cordis-plugin-loader": {
      "optional": true
    }
  }
}
