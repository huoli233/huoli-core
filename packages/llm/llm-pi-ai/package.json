{
  "name": "@huoli/huoli-llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the Huoli Core LLM seam (design-verification twin of huoli-llm-deepseek)",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/cordis-plugin-loader": "workspace:~",
    "@huoli/huoli-attachment": "workspace:*",
    "@huoli/huoli-authorization": "workspace:*",
    "@huoli/huoli-credentials": "workspace:*",
    "@huoli/huoli-fs": "workspace:*",
    "@huoli/huoli-launch-environment": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-timeout": "workspace:*"
  },
  "dependencies": {
    "@huoli/huoli-brand": "workspace:*",
    "@huoli/huoli-util-values": "workspace:*",
    "@huoli/schemastery": "workspace:~",
    "@earendil-works/pi-ai": "^1.3.0"
  },
  "devDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/cordis-plugin-loader": "workspace:~",
    "@huoli/huoli-agent-loop-testkit": "workspace:*",
    "@huoli/huoli-attachment": "workspace:*",
    "@huoli/huoli-authorization": "workspace:*",
    "@huoli/huoli-credentials": "workspace:*",
    "@huoli/huoli-fs": "workspace:*",
    "@huoli/huoli-http-proxy": "workspace:*",
    "@huoli/huoli-launch-environment": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-llm-deepseek": "workspace:*",
    "@huoli/huoli-llm-deepseek-api-key": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-settings": "workspace:*",
    "@huoli/huoli-timeout": "workspace:*",
    "@huoli/huoli-tool-testkit": "workspace:*",
    "@huoli/huoli-tools": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@huoli/cordis-plugin-loader": {
      "optional": true
    }
  }
}
