{
  "name": "@huoli/huoli-agent-preset-registry",
  "description": "Declarative Agent preset registry and profile-backed editing",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/preset/agent-preset-registry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./display": {
      "types": "./lib/types/display.d.ts",
      "default": "./lib/types/display.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@huoli/cordis-plugin-include": "workspace:~",
    "@huoli/cordis-plugin-loader": "workspace:~",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-scope": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-session-projection": "workspace:*",
    "@huoli/huoli-settings": "workspace:*",
    "@huoli/huoli-system-prompt": "workspace:*",
    "@huoli/huoli-tools": "workspace:*",
    "@huoli/huoli-typert-protocol": "workspace:*",
    "@huoli/cordis": "workspace:~"
  },
  "dependencies": {
    "@huoli/huoli-app-boot": "workspace:*",
    "@huoli/schemastery": "workspace:~",
    "zod": "4.4.3",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@huoli/cordis-plugin-group": "workspace:~",
    "@huoli/cordis-plugin-include": "workspace:~",
    "@huoli/cordis-plugin-loader": "workspace:~",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-agent-loop": "workspace:*",
    "@huoli/huoli-atomic-write": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-scope": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-session-projection": "workspace:*",
    "@huoli/huoli-settings": "workspace:*",
    "@huoli/huoli-system-prompt": "workspace:*",
    "@huoli/huoli-tool-executor-native": "workspace:*",
    "@huoli/huoli-tool-executor-ptc": "workspace:*",
    "@huoli/huoli-tool-testkit": "workspace:*",
    "@huoli/huoli-tools": "workspace:*",
    "@huoli/huoli-typert-protocol": "workspace:*",
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-fs-local": "workspace:*",
    "@huoli/huoli-hmr": "workspace:*",
    "@huoli/huoli-ptc-runtime": "workspace:*",
    "@huoli/huoli-sandbox": "workspace:*",
    "@huoli/huoli-sandbox-policy": "workspace:*",
    "@huoli/huoli-user-approval": "workspace:*",
    "@huoli/huoli-agent-preset": "workspace:*",
    "@huoli/huoli-working-directory": "workspace:*",
    "@types/js-yaml": "^4.0.9"
  }
}
