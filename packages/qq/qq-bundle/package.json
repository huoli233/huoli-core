{
  "name": "@huoli/huoli-qq-bundle",
  "description": "把 QQ 机器人的各个零件装到一起",
  "version": "0.2.2-alpha.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "prompts/*.md",
    "qq.patch.yml"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-system-prompt": "workspace:*",
    "@huoli/huoli-tools": "workspace:*"
  },
  "devDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/cordis-plugin-include": "workspace:~",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-system-prompt": "workspace:*",
    "@huoli/huoli-tools": "workspace:*",
    "js-yaml": "^4.3.2"
  },
  "dependencies": {
    "@huoli/huoli-experimental-speech-to-text": "workspace:*",
    "@huoli/huoli-experimental-speech-to-text-sensevoice": "workspace:*",
    "@huoli/huoli-attachment": "workspace:*",
    "@huoli/huoli-brand": "workspace:*",
    "@huoli/huoli-home-paths": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-qq-balance": "workspace:*",
    "@huoli/huoli-qq-attention": "workspace:*",
    "@huoli/huoli-qq-channel": "workspace:*",
    "@huoli/huoli-qq-continuity": "workspace:*",
    "@huoli/huoli-qq-longing": "workspace:*",
    "@huoli/huoli-qq-material": "workspace:*",
    "@huoli/huoli-qq-memory": "workspace:*",
    "@huoli/huoli-qq-pacing": "workspace:*",
    "@huoli/huoli-qq-policy": "workspace:*",
    "@huoli/huoli-qq-proactive": "workspace:*",
    "@huoli/huoli-qq-self": "workspace:*",
    "@huoli/huoli-qq-subject": "workspace:*",
    "@huoli/huoli-qq-vitals": "workspace:*",
    "@huoli/huoli-sandbox-policy": "workspace:*",
    "@huoli/huoli-schedule": "workspace:*"
  },
  "huoli": {
    "bundle": {
      "patch": [
        "./qq.patch.yml"
      ]
    }
  }
}
