{
  "name": "@huoli/huoli-command-compact",
  "description": "Human-facing slash command for explicit session compaction",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huoli233/huoli-core.git",
    "directory": "packages/compaction/command-compact"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@huoli/huoli-commands": "workspace:*",
    "@huoli/huoli-compaction": "workspace:*",
    "@huoli/cordis": "workspace:~"
  },
  "devDependencies": {
    "@huoli/cordis-plugin-include": "workspace:~",
    "@huoli/cordis-plugin-loader": "workspace:~",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-commands": "workspace:*",
    "@huoli/huoli-compaction": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/cordis": "workspace:~"
  }
}
