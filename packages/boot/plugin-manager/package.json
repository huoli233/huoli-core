{
  "name": "@huoli/huoli-plugin-manager",
  "description": "Current-profile plugin and bundle management shared by huoli CLI, Web and agent tools",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/boot/plugin-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./registry": {
      "types": "./lib/types/registry.d.ts",
      "default": "./lib/types/registry.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./operations": {
      "types": "./lib/types/operations.d.ts",
      "default": "./lib/types/operations.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    },
    "./tools/locale/*.json": "./locale/tools/*.json",
    "./locale/*.json": "./locale/*.json",
    "./diagnostic": {
      "types": "./lib/types/diagnostic.d.ts",
      "default": "./lib/types/diagnostic.js"
    }
  },
  "files": [
    "locale/*.json",
    "locale/tools/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@huoli/huoli-app-boot": "workspace:*",
    "@huoli/huoli-atomic-write": "workspace:*",
    "@huoli/huoli-official-bundles": "workspace:*",
    "@huoli/schemastery": "workspace:~",
    "execa": "^10.0.1",
    "semver": "^7.8.5",
    "yaml": "^2.9.0",
    "zod": "4.4.3",
    "@huoli/huoli-util-values": "workspace:*",
    "@huoli/huoli-plugin-detail": "workspace:*",
    "@huoli/huoli-timeout": "workspace:*",
    "hosted-git-info": "^9.0.3"
  },
  "peerDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/cordis-plugin-loader": "workspace:~",
    "@huoli/huoli-host-plugin-inventory": "workspace:*",
    "@huoli/huoli-subprocess": "workspace:*",
    "@huoli/huoli-typert-protocol": "workspace:*",
    "@huoli/huoli-tools": "workspace:*",
    "@huoli/huoli-hmr": "workspace:*",
    "@huoli/huoli-brand": "workspace:*",
    "@huoli/huoli-sandbox-policy": "workspace:*",
    "@huoli/huoli-sandbox": "workspace:*",
    "@huoli/huoli-user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@huoli/huoli-hmr": {
      "optional": true
    },
    "@huoli/huoli-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "chokidar": "^4.0.3",
    "@types/semver": "^7.8.0",
    "@huoli/huoli-package-manifest": "workspace:*",
    "@huoli/cordis": "workspace:~",
    "@huoli/cordis-plugin-loader": "workspace:~",
    "@huoli/huoli-host-plugin-inventory": "workspace:*",
    "@huoli/huoli-subprocess": "workspace:*",
    "@huoli/huoli-typert-protocol": "workspace:*",
    "@huoli/huoli-tool-executor-native": "workspace:*",
    "@huoli/huoli-tool-testkit": "workspace:*",
    "@huoli/huoli-tools": "workspace:*",
    "@huoli/huoli-system-prompt": "workspace:*",
    "@huoli/huoli-hmr": "workspace:*",
    "@huoli/cordis-plugin-timer": "workspace:~",
    "@huoli/huoli-brand": "workspace:*",
    "@huoli/huoli-sandbox-policy": "workspace:*",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-session-projection": "workspace:*",
    "@huoli/huoli-sandbox": "workspace:*",
    "@huoli/huoli-user-approval": "workspace:*",
    "@huoli/huoli-client-connection": "workspace:*",
    "@types/hosted-git-info": "^3.0.5"
  }
}
