{
  "name": "@huoli/huoli-hmr",
  "description": "Coordinated module and profile configuration hot reload",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/boot/hmr"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "author": "Shigma <shigma10826@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@huoli/cordis-plugin-timer": "workspace:~",
    "@huoli/cordis": "workspace:~",
    "@huoli/cordis-plugin-loader": "workspace:~",
    "@huoli/cordis-plugin-include": "workspace:~",
    "@huoli/huoli-app-boot": "workspace:*",
    "@huoli/huoli-cmdline": "workspace:*"
  },
  "dependencies": {
    "@babel/code-frame": "^7.29.0",
    "chokidar": "5.0.0",
    "node-addon-require-builtin": "^0.1.9",
    "picomatch": "^4.0.7",
    "@huoli/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@types/babel__code-frame": "^7.27.0",
    "@types/picomatch": "^4.0.3",
    "esbuild": "^0.28.2",
    "@huoli/cordis-plugin-timer": "workspace:~",
    "@huoli/cordis": "workspace:~",
    "@huoli/cordis-plugin-loader": "workspace:~",
    "@huoli/cordis-plugin-include": "workspace:~",
    "@huoli/huoli-app-boot": "workspace:*",
    "@huoli/huoli-cmdline": "workspace:*",
    "@huoli/huoli-atomic-write": "workspace:*"
  }
}
