{
  "name": "@huoli/huoli-tool-jobs",
  "description": "Model-facing background job control tools (job_output, job_list, job_kill) over the ctx.jobs registry",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huoli233/huoli-core.git",
    "directory": "packages/jobs/tool-jobs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@huoli/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-output-retention": "workspace:*",
    "@huoli/huoli-system-prompt": "workspace:*",
    "@huoli/huoli-jobs": "workspace:*",
    "@huoli/huoli-tools": "workspace:*",
    "@huoli/cordis": "workspace:~"
  },
  "devDependencies": {
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-output-retention": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-system-prompt": "workspace:*",
    "@huoli/huoli-jobs": "workspace:*",
    "@huoli/huoli-jobs-local": "workspace:*",
    "@huoli/huoli-tool-executor-native": "workspace:*",
    "@huoli/huoli-tool-testkit": "workspace:*",
    "@huoli/huoli-tools": "workspace:*",
    "@huoli/cordis": "workspace:~"
  }
}
