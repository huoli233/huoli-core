{
  "name": "@huoli/huoli-fs-local",
  "description": "Local-filesystem implementation of the Huoli Core filesystem seam (ctx.fs)",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/fs/fs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@huoli/huoli-fs": "workspace:*",
    "@huoli/cordis": "workspace:~"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "koffi": "3.1.1",
    "@huoli/schemastery": "workspace:~",
    "@huoli/huoli-fs-patch": "workspace:*"
  },
  "devDependencies": {
    "@huoli/huoli-fs": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/cordis": "workspace:~"
  }
}
