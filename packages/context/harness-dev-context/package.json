{
  "name": "@huoli/huoli-harness-dev-context",
  "description": "Model context naming the Huoli Core checkout and Web GUI URL without letting either change the system prompt",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huoli233/huoli-core.git",
    "directory": "packages/context/harness-dev-context"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-session-projection": "workspace:*",
    "@huoli/huoli-system-prompt": "workspace:*"
  },
  "devDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-agent-loop-testkit": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-session-projection": "workspace:*",
    "@huoli/huoli-system-prompt": "workspace:*"
  }
}
