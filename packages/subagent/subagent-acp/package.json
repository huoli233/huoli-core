{
  "name": "@huoli/huoli-subagent-acp",
  "description": "Out-of-process ACP subagent backend: drives a child agent in a spawned subprocess over the Agent Client Protocol",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huoli233/huoli-core.git",
    "directory": "packages/subagent/subagent-acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-subagent": "workspace:*",
    "@huoli/huoli-subprocess": "workspace:*",
    "@huoli/huoli-timeout": "workspace:*"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@huoli/huoli-brand": "workspace:*",
    "@huoli/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/cordis-plugin-loader": "workspace:~",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-app-boot": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-loader-smoke": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-session-checkpoint-policy": "workspace:*",
    "@huoli/huoli-session-persistence-jsonl": "workspace:*",
    "@huoli/huoli-session-projection": "workspace:*",
    "@huoli/huoli-subagent": "workspace:*",
    "@huoli/huoli-subprocess": "workspace:*",
    "@huoli/huoli-subprocess-local": "workspace:*",
    "@huoli/huoli-timeout": "workspace:*",
    "@huoli/huoli-tool-subagent": "workspace:*"
  }
