{
  "name": "@huoli/huoli-subagent-huoli-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child Huoli Core runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent-huoli-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-sdk-client": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-subagent": "workspace:*",
    "@huoli/huoli-subprocess": "workspace:*"
  },
  "dependencies": {
    "@huoli/huoli-brand": "workspace:*",
    "@huoli/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/cordis-plugin-loader": "workspace:~",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-agent-instructions": "workspace:*",
    "@huoli/huoli-app-boot": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-llm-deepseek": "workspace:*",
    "@huoli/huoli-llm-deepseek-api-key": "workspace:*",
    "@huoli/huoli-loader-smoke": "workspace:*",
    "@huoli/huoli-sdk-client": "workspace:*",
    "@huoli/huoli-sdk-protocol": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-session-checkpoint-policy": "workspace:*",
    "@huoli/huoli-session-persistence-jsonl": "workspace:*",
    "@huoli/huoli-session-projection": "workspace:*",
    "@huoli/huoli-skill-filesystem": "workspace:*",
    "@huoli/huoli-subagent": "workspace:*",
    "@huoli/huoli-subprocess": "workspace:*",
    "@huoli/huoli-system-prompt": "workspace:*",
    "@huoli/huoli-tool-subagent": "workspace:*"
  }
}
