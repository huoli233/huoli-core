{
  "name": "@huoli/huoli-subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huoli233/huoli-core.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "huoli": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-subagent": "workspace:*",
    "@huoli/huoli-subprocess": "workspace:*",
    "@huoli/huoli-timeout": "workspace:*"
  },
  "dependencies": {
    "@huoli/huoli-brand": "workspace:*",
    "@huoli/huoli-sdk-protocol": "workspace:*",
    "@huoli/schemastery": "workspace:~",
    "@openai/codex": "0.153.4",
    "@huoli/huoli-tool-subagent": "workspace:*"
  },
  "devDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/cordis-plugin-loader": "workspace:~",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-app-boot": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-loader-smoke": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-session-checkpoint-policy": "workspace:*",
    "@huoli/huoli-session-persistence-jsonl": "workspace:*",
    "@huoli/huoli-session-projection": "workspace:*",
    "@huoli/huoli-subagent": "workspace:*",
    "@huoli/huoli-subprocess": "workspace:*",
    "@huoli/huoli-subprocess-local": "workspace:*",
    "@huoli/huoli-timeout": "workspace:*",
    "@huoli/huoli-tool-jobs": "workspace:*",
    "@huoli/huoli-tools": "workspace:*"
  },
  "icon": "./icon.svg"
}
