{
  "name": "@huoli/huoli-terminal-bash",
  "description": "Persistent shell PTY backend over the Huoli Core subprocess terminal primitive",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-terminal": "workspace:*",
    "@huoli/huoli-sandbox": "workspace:*",
    "@huoli/huoli-sandbox-policy": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-subprocess": "workspace:*",
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-working-directory": "workspace:*"
  },
  "dependencies": {
    "@huoli/huoli-lazy-require": "workspace:*",
    "@huoli/huoli-pwsh-local": "workspace:*",
    "@huoli/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-agent-loop-testkit": "workspace:*",
    "@huoli/huoli-terminal": "workspace:*",
    "@huoli/huoli-sandbox": "workspace:*",
    "@huoli/huoli-sandbox-policy": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-session-projection": "workspace:*",
    "@huoli/huoli-subprocess": "workspace:*",
    "@huoli/huoli-subprocess-local": "workspace:*",
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-working-directory": "workspace:*"
  }
}
