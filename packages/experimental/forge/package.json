{
  "name": "@huoli/huoli-experimental-forge",
  "description": "Provider-neutral change request registry with shared status polling",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huoli233/huoli-core.git",
    "directory": "packages/experimental/forge"
  },
  "dependencies": {
    "@huoli/schemastery": "workspace:~",
    "@huoli/huoli-brand": "workspace:*",
    "@huoli/huoli-timeout": "workspace:*"
  },
  "peerDependencies": {
    "@huoli/cordis": "workspace:~"
  },
  "devDependencies": {
    "@huoli/cordis": "workspace:~"
  }
}
