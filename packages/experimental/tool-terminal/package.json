{
  "name": "@huoli/huoli-tool-terminal",
  "description": "Six model-facing persistent PTY tools with owner isolation and generic background-job integration",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/tool-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@huoli/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-terminal": "workspace:*",
    "@huoli/huoli-output-retention": "workspace:*",
    "@huoli/huoli-system-prompt": "workspace:*",
    "@huoli/huoli-jobs": "workspace:*",
    "@huoli/huoli-tools": "workspace:*",
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@huoli/cordis-plugin-include": "workspace:~",
    "@huoli/cordis-plugin-loader": "workspace:~",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-agent-loop-testkit": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-terminal": "workspace:*",
    "@huoli/huoli-terminal-bash": "workspace:*",
    "@huoli/huoli-output-retention": "workspace:*",
    "@huoli/huoli-sandbox": "workspace:*",
    "@huoli/huoli-sandbox-policy": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-subprocess-local": "workspace:*",
    "@huoli/huoli-system-prompt": "workspace:*",
    "@huoli/huoli-jobs": "workspace:*",
    "@huoli/huoli-jobs-local": "workspace:*",
    "@huoli/huoli-tool-executor-native": "workspace:*",
    "@huoli/huoli-tool-executor-ptc": "workspace:*",
    "@huoli/huoli-tool-jobs": "workspace:*",
    "@huoli/huoli-tool-testkit": "workspace:*",
    "@huoli/huoli-tools": "workspace:*",
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-session-projection": "workspace:*",
    "@huoli/huoli-working-directory": "workspace:*"
  }
}
