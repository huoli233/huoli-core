{
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "name": "@huoli/huoli-client-ui-creation-recommendations",
  "description": "Body of the personalized page card: location choice, creation progress, Keep, Undo and Restore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/client-ui-creation-recommendations"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "huoli": {
    "client": {
      "platform": "web",
      "inject": [
        "@huoli/huoli-client-locale",
        "@huoli/huoli-client-ui-action-cards"
      ]
    }
  },
  "peerDependencies": {
    "@huoli/cordis": "workspace:~"
  },
  "devDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-client-ui-renderer": "workspace:*",
    "@huoli/huoli-client-locale": "workspace:*",
    "@huoli/huoli-client-ui-slots": "workspace:*",
    "@huoli/huoli-client-ui-primitives": "workspace:*",
    "react": "^18.2.0",
    "@huoli/huoli-creation-recommendations": "workspace:*",
    "@huoli/huoli-client-store": "workspace:*",
    "@huoli/huoli-client-ui-action-cards": "workspace:*",
    "@huoli/huoli-action-cards": "workspace:*",
    "zod": "4.4.3",
    "@huoli/huoli-client-test-runtime": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-session": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
