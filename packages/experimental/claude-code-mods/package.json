{
  "name": "@huoli/huoli-experimental-claude-code-mods",
  "description": "Experimental bridge: load Claude Code mods (hooks modules) and run their hook chains on Huoli Core extension points",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/claude-code-mods"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./testing": {
      "types": "./lib/types/testing.d.ts",
      "default": "./lib/types/testing.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./examples/*": "./examples/*",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@huoli/huoli-util-crypto": "workspace:*",
    "@huoli/huoli-util-values": "workspace:*",
    "@huoli/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-commands": "workspace:*",
    "@huoli/huoli-fs": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-scope": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-storage-domain": "workspace:*",
    "@huoli/huoli-subprocess": "workspace:*",
    "@huoli/huoli-token-meter": "workspace:*",
    "@huoli/huoli-tools": "workspace:*",
    "@huoli/huoli-typert-protocol": "workspace:*",
    "@huoli/huoli-user-questions": "workspace:*",
    "@huoli/huoli-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/cordis-plugin-include": "workspace:~",
    "@huoli/cordis-plugin-loader": "workspace:~",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-agent-loop": "workspace:*",
    "@huoli/huoli-agent-loop-testkit": "workspace:*",
    "@huoli/huoli-attachment": "workspace:*",
    "@huoli/huoli-commands": "workspace:*",
    "@huoli/huoli-fs": "workspace:*",
    "@huoli/huoli-fs-local": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-scope": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-session-projection": "workspace:*",
    "@huoli/huoli-storage": "workspace:*",
    "@huoli/huoli-storage-domain": "workspace:*",
    "@huoli/huoli-storage-json": "workspace:*",
    "@huoli/huoli-subprocess": "workspace:*",
    "@huoli/huoli-subprocess-local": "workspace:*",
    "@huoli/huoli-system-prompt": "workspace:*",
    "@huoli/huoli-token-meter": "workspace:*",
    "@huoli/huoli-tool-executor-native": "workspace:*",
    "@huoli/huoli-tool-testkit": "workspace:*",
    "@huoli/huoli-tools": "workspace:*",
    "@huoli/huoli-typert-protocol": "workspace:*",
    "@huoli/huoli-user-questions": "workspace:*",
    "@huoli/huoli-working-directory": "workspace:*",
    "@huoli/huoli-session-persistence-jsonl": "workspace:*"
  }
}
