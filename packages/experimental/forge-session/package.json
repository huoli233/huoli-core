    "@huoli/huoli-shell": {
      "optional": true
    },
    "@huoli/huoli-shell-env": {
      "optional": true
    },
    "@huoli/huoli-tools": {
      "optional": true
    },
    "@huoli/huoli-sandbox-policy": {
      "optional": true
    }
  }
