{
  "name": "@huoli/huoli-experimental-cua-macos",
  "description": "macOS native provider for shared Computer Use application and window objects",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/cua-macos"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "native/bin",
    "cua-helper.json",
    "native/Package.swift",
    "native/Info.plist",
    "native/DSHComputerUse.icns",
    "native/build_app.py",
    "native/Sources",
    "native/tests/swift",
    "native/tests/test_swift.py",
    "native/LICENSE.cua-driver",
    "native/LICENSE.computer-use-icon",
    "native/upstream.json",
    "native/README.md",
    "native/README.zh.md",
    "native/protocol.schema.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-computer-use": "workspace:*",
    "@huoli/huoli-system-prompt": "workspace:*",
    "@huoli/huoli-tools": "workspace:*",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-subprocess": "workspace:*",
    "@huoli/huoli-user-questions": "workspace:*"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@huoli/huoli-atomic-write": "workspace:*",
    "@huoli/huoli-cua": "workspace:*"
  },
  "devDependencies": {
    "@huoli/huoli-working-directory": "workspace:*",
    "@huoli/cordis": "workspace:~",
    "@huoli/cordis-plugin-include": "workspace:~",
    "@huoli/cordis-plugin-loader": "workspace:~",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-agent-loop": "workspace:*",
    "@huoli/huoli-agent-loop-testkit": "workspace:*",
    "@huoli/huoli-attachment": "workspace:*",
    "@huoli/huoli-attachment-local": "workspace:*",
    "@huoli/huoli-computer-use": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-session-projection": "workspace:*",
    "@huoli/huoli-system-prompt": "workspace:*",
    "@huoli/huoli-tool-executor-native": "workspace:*",
    "@huoli/huoli-tool-executor-ptc": "workspace:*",
    "@huoli/huoli-tool-testkit": "workspace:*",
    "@huoli/huoli-tools": "workspace:*",
    "@huoli/huoli-subprocess": "workspace:*",
    "@huoli/huoli-subprocess-local": "workspace:*",
    "@huoli/huoli-fs-local": "workspace:*",
    "@huoli/huoli-llm-deepseek": "workspace:*",
    "@huoli/huoli-ptc-runtime-node": "workspace:*",
    "@huoli/huoli-sandbox-local": "workspace:*",
    "@huoli/huoli-sandbox-policy": "workspace:*",
    "sharp": "^0.35.3",
    "@huoli/huoli-ptc-runtime": "workspace:*",
    "@huoli/huoli-user-questions": "workspace:*",
    "@huoli/huoli-settings": "workspace:*",
    "@huoli/huoli-app-boot": "workspace:*",
    "@huoli/huoli-config-editor": "workspace:*",
    "@huoli/huoli-hmr": "workspace:*",
    "@huoli/cordis-plugin-timer": "workspace:~",
    "@huoli/huoli-storage": "workspace:*",
    "@huoli/huoli-storage-json": "workspace:*",
    "@huoli/huoli-storage-domain": "workspace:*"
  },
  "scripts": {
    "build:native": "xcrun python3 native/build_app.py",
    "build:icon": "node native/generate_icon.mjs"
  },
  "os": [
    "darwin"
  ]
}
