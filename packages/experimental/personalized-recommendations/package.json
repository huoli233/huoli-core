{
  "name": "@huoli/huoli-personalized-recommendations",
  "description": "Personalized pages and built-in plugin recommendations offered as cards below answers",
  "version": "0.2.2-alpha.2",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huoli233/huoli-core.git",
    "directory": "packages/experimental/personalized-recommendations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@huoli/huoli-action-cards": "workspace:*",
    "@huoli/huoli-client-ui-action-cards": "workspace:*",
    "@huoli/huoli-creation-recommendations": "workspace:*",
    "@huoli/huoli-client-ui-creation-recommendations": "workspace:*",
    "@huoli/huoli-plugin-recommendations": "workspace:*",
    "@huoli/huoli-client-ui-plugin-recommendations": "workspace:*"
  },
  "peerDependencies": {
    "@huoli/cordis": "workspace:~"
  },
  "devDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/cordis-plugin-include": "workspace:~",
    "js-yaml": "^4.3.2",
    "@huoli/cordis-plugin-timer": "workspace:~",
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-api-remote-access": "workspace:*",
    "@huoli/huoli-app-boot": "workspace:*",
    "@huoli/huoli-hmr": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-plugin-manager": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-session-projection": "workspace:*",
    "@huoli/huoli-skill": "workspace:*",
    "@huoli/huoli-system-prompt": "workspace:*",
    "@huoli/huoli-tool-executor-native": "workspace:*",
    "@huoli/huoli-tools": "workspace:*"
  },
  "huoli": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
