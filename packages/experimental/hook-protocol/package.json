{
  "name": "@huoli/huoli-hook-protocol",
  "description": "Shared Claude Code / Codex hook wire protocol: matcher engine, stdin/exit-code/stdout codec, multi-hook merge, and hook/* session events",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huoli233/huoli-core.git",
    "directory": "packages/experimental/hook-protocol"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@huoli/huoli-shell": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/cordis": "workspace:~"
  },
  "devDependencies": {
    "@huoli/huoli-shell": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/cordis": "workspace:~"
  }
}
