{
  "name": "@huoli/huoli-hooks-claude-code",
  "description": "Bridge plugin: run a Claude Code hooks.json / settings hook config on the Huoli Core interception seams",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/hooks-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@huoli/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-hook-protocol": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-subagent": "workspace:*",
    "@huoli/huoli-tools": "workspace:*",
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@huoli/huoli-agent": "workspace:*",
    "@huoli/huoli-agent-loop": "workspace:*",
    "@huoli/huoli-agent-loop-testkit": "workspace:*",
    "@huoli/huoli-shell": "workspace:*",
    "@huoli/huoli-bash-local": "workspace:*",
    "@huoli/huoli-subprocess-local": "workspace:*",
    "@huoli/huoli-hook-protocol": "workspace:*",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-session": "workspace:*",
    "@huoli/huoli-session-persistence-jsonl": "workspace:*",
    "@huoli/huoli-subagent": "workspace:*",
    "@huoli/huoli-tool-testkit": "workspace:*",
    "@huoli/huoli-tools": "workspace:*",
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-session-projection": "workspace:*",
    "@huoli/huoli-working-directory": "workspace:*",
    "@huoli/huoli-fs-local": "workspace:*"
  }
}
