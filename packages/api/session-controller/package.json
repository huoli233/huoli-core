    "@huoli/huoli-session-projection": "workspace:*",
    "@huoli/huoli-session-projection-cache": "workspace:*",
    "@huoli/huoli-session-query": "workspace:*",
    "@huoli/huoli-session-title": "workspace:*",
    "@huoli/huoli-settings": "workspace:*",
    "@huoli/huoli-skill": "workspace:*",
    "@huoli/huoli-storage": "workspace:*",
    "@huoli/huoli-storage-domain": "workspace:*",
    "@huoli/huoli-storage-json": "workspace:*",
    "@huoli/huoli-subagent": "workspace:*",
    "@huoli/huoli-typert-protocol": "workspace:*",
