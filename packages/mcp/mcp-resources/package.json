{
  "name": "@huoli/huoli-mcp-resources",
  "description": "Scoped MCP resource discovery and reading through shared model tools",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huoli233/huoli-core.git",
    "directory": "packages/mcp/mcp-resources"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-scope": "workspace:*",
    "@huoli/huoli-system-prompt": "workspace:*",
    "@huoli/huoli-tools": "workspace:*"
  },
  "devDependencies": {
    "@huoli/cordis": "workspace:~",
    "@huoli/huoli-llm": "workspace:*",
    "@huoli/huoli-ptc-runtime": "workspace:*",
    "@huoli/huoli-scope": "workspace:*",
    "@huoli/huoli-tool-executor-native": "workspace:*",
    "@huoli/huoli-tool-executor-ptc": "workspace:*",
    "@huoli/huoli-tool-testkit": "workspace:*",
    "@huoli/huoli-tools": "workspace:*",
    "@huoli/huoli-system-prompt": "workspace:*",
    "@huoli/huoli-agent": "workspace:*"
  },
  "dependencies": {
    "@huoli/huoli-util-values": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@huoli/huoli-system-prompt": {
      "optional": true
    }
  }
}
